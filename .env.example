# Override this when deploying against a different AradLens API.
ARADLENS_API_ORIGIN=https://api.aradlens.binarysquad.club
PORT=4173
# Set to true to enable the local dev login (never enable in production).
DEV_MODE=
# Public base URL used in generated capture links, e.g. https://admin.aradlens.ro
# Leave empty to use the host from the incoming request.
PUBLIC_ORIGIN=

# Where accepted terms/consent records are stored. Keep this outside the web root or restrict access.
CONSENT_LOG_PATH=./data/consent.log

# Optional comma-separated proxy IPs allowed to supply X-Forwarded-For.
# Leave empty to trust only private/loopback peers.
TRUSTED_PROXIES=
